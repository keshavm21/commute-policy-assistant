# Copy to .env and fill in. Never commit .env.

# LLM (any OpenAI-compatible endpoint). Free Groq key: https://console.groq.com/keys
# Leave LLM_API_KEY empty to run with the offline fake LLM (no real answers).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Only for models that accept it, e.g. LLM_MODEL=openai/gpt-oss-120b with LLM_REASONING_EFFORT=low
LLM_REASONING_EFFORT=

# Secret used to sign the demo JWTs. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# vector (default) | hybrid. See eval/REPORT.md for the before/after comparison.
RETRIEVAL_MODE=vector
